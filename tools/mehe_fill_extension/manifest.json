{
  "manifest_version": 3,
  "name": "MSA — تعبئة الوزارة وصندوق التعويضات",
  "description": "يعبّئ خانات موازنة منصّة مصلحة التعليم الخاص (psb.mehe.gov.lb) وبيانات بوّابة صندوق التعويضات (caisseindemnite.com) من أرقام برنامج الرواتب MSA. الإرسال والاعتماد يبقيان بيدك على الموقع.",
  "version": "1.1.0",
  "icons": { "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "تعبئة الوزارة وصندوق التعويضات من البرنامج" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://psb.mehe.gov.lb/*",
    "https://www.caisseindemnite.com/*",
    "https://caisseindemnite.com/*",
    "http://localhost/*",
    "https://msapayroll.com/*",
    "https://www.msapayroll.com/*",
    "https://192.168.1.60/*"
  ],
  "content_scripts": [
    { "matches": ["https://psb.mehe.gov.lb/*"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["https://www.caisseindemnite.com/*", "https://caisseindemnite.com/*"], "js": ["content_eoc.js"], "run_at": "document_idle" }
  ]
}
