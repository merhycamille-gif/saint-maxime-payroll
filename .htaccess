# رفع ملفات كبيرة بلا حدود عملياً (صور/وثائق الأساتذة)
php_value upload_max_filesize 1024M
php_value post_max_size 1024M
php_value max_execution_time 600
php_value max_input_time 600
php_value memory_limit 512M

# ─────────────────────────────────────────────────────────────────────
# دعم الدومين المستقل msapayroll.com (add-on domain: جذرُه = مجلّد البرنامج نفسه)
# على هذا الدومين صار البرنامج جذر الموقع، لكن الروابط الداخلية ما زالت
# تحمل بادئة المجلّد القديم (BASE_URL=/saint-maxime-payroll/) أو مسار الأساتذة
# (/msa-payroll/). نُزيل هاتين البادئتين داخلياً فقط على هذا الدومين ليُخدَم
# الملف الصحيح من الجذر. محميّ بشرط المضيف → لا يمسّ maximos-rawatib.com إطلاقاً.
<IfModule mod_rewrite.c>
RewriteEngine On
# ─────────────────────────────────────────────────────────────────────
# 🖥️ (2026-09-29 «القديم خلص شغّلني دايماً على الجديد»): البرنامج انتقل إلى السيرفر الجديد msapayroll.com.
# أي فتح على العنوان القديم maximos-rawatib.com (الأيقونات والروابط القديمة وروابط الأساتذة المبعوتة)
# يتحوّل تلقائياً إلى نفس الصفحة على الجديد — فلا يُدخَل شيء على قاعدة السيرفر القديم بعد اليوم.
# GET/HEAD = 302، وغيرها (POST) = 307 ليبقى المحتوى المُرسَل. «msa_old=1» = باب صيانة للمدير فقط.
RewriteCond %{HTTP_HOST} ^(www\.)?maximos-rawatib\.com$ [NC]
RewriteCond %{QUERY_STRING} !(^|&)msa_old=1(&|$)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^(.*)$ https://msapayroll.com/$1 [R=302,L]
RewriteCond %{HTTP_HOST} ^(www\.)?maximos-rawatib\.com$ [NC]
RewriteCond %{QUERY_STRING} !(^|&)msa_old=1(&|$)
RewriteRule ^(.*)$ https://msapayroll.com/$1 [R=307,L]
RewriteCond %{HTTP_HOST} ^(www\.)?msapayroll\.com$ [NC]
RewriteRule ^saint-maxime-payroll/(.*)$ $1 [L]
RewriteCond %{HTTP_HOST} ^(www\.)?msapayroll\.com$ [NC]
RewriteRule ^msa-payroll/(.*)$ $1 [L]
</IfModule>
